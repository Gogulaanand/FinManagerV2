{
  "name": "finmanager",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "op-sqlite": {
    "sqlcipher": true
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "check": "turbo run build test lint typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "recovery:drill": "node scripts/r2-recovery-drill.mjs",
    "test:recovery-drill": "node --test scripts/r2-recovery-drill.test.mjs",
    "test:ai-usage-concurrency": "node scripts/test-ai-usage-concurrency.mjs",
    "test:database:fresh": "node scripts/test-l3-1-fresh-migration.mjs",
    "web": "pnpm --filter @finmanager/web dev",
    "mobile": "pnpm --filter @finmanager/mobile start"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.19.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.7.0",
    "prettier": "3.9.5",
    "supabase": "^2.109.1",
    "turbo": "2.10.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vitest": "4.1.10"
  }
}
