NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_POWERSYNC_URL=

# Sentry runtime reporting. The public DSN is intentionally safe for the browser.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Build-only source-map upload values. Keep all three secret/environment backed.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Optional protected production smoke endpoint: POST /api/monitoring-test.
SENTRY_TEST_TOKEN=
