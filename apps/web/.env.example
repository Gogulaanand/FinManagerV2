# Copy to .env.local (gitignored) and fill in. All three are safe to ship in the
# client bundle: the Supabase publishable/anon key and PowerSync URL are public
# client identifiers, not secrets. Row-level security is the real boundary.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
NEXT_PUBLIC_POWERSYNC_URL=https://<id>.powersync.journeyapps.com
