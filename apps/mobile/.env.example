# Copy to .env (gitignored) and fill in. Expo inlines EXPO_PUBLIC_* vars into the
# bundle; these are public client identifiers, not secrets. RLS is the real
# boundary.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
EXPO_PUBLIC_POWERSYNC_URL=https://<id>.powersync.journeyapps.com
EXPO_PUBLIC_SENTRY_DSN=https://<public-key>@<host>/<project-id>
